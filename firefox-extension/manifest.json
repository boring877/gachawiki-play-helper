{
  "manifest_version": 3,
  "name": "GachaWiki Play Helper",
  "version": "1.0.0",
  "description": "Region cookie manager and DMM-only proxy router for playing Japanese browser games abroad. Companion tool for gachawiki.info",
  "browser_specific_settings": {
    "gecko": {
      "id": "play-helper@gachawiki.info",
      "strict_min_version": "115.0"
    }
  },
  "permissions": ["cookies", "storage", "proxy", "webRequest", "webRequestAuthProvider"],
  "host_permissions": [
    "*://*.dmm.com/*",
    "*://*.dmm.co.jp/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "GachaWiki Play Helper",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "options.html"
}
